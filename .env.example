# Discord bot credentials — create a copy of this file as `.env` and fill in values.
# Get these from: https://discord.com/developers/applications

# Bot token (Bot -> Token -> Reset/View)
DISCORD_TOKEN=your-bot-token-here

# Application / Client ID (General Information -> Application ID)
CLIENT_ID=your-client-id-here

# Guild ID for guild-scoped slash command registration (optional, dev only)
GUILD_ID=your-guild-id-here
